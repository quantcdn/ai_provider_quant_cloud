<?php

declare(strict_types=1);

/**
 * @file
 * Install and update hooks for the Quant Cloud AI Provider module.
 */

use Drupal\Core\Extension\Requirement\RequirementSeverity;
use Drupal\Core\Url;
use Drupal\ai_provider_quant_cloud\Service\AuthService;

/**
 * Implements hook_requirements().
 */
function ai_provider_quant_cloud_requirements($phase): array {
  if ($phase !== 'runtime') {
    return [];
  }
  $reason = \Drupal::service('ai_provider_quant_cloud.auth')->getReconnectReason();
  if ($reason === NULL) {
    return [];
  }

  $is_error = $reason === AuthService::RECONNECT_OTHER_SITE;
  // RequirementSeverity exists from drupal:11.2; drupal:12 requires it.
  $has_enum = class_exists(RequirementSeverity::class);
  $severity = $is_error ? 2 : 1;
  if ($has_enum) {
    $severity = $is_error ? RequirementSeverity::Error : RequirementSeverity::Warning;
  }

  return [
    'ai_provider_quant_cloud_oauth' => [
      'title' => t('Quant Cloud AI Provider'),
      'value' => t('Reconnect required'),
      'description' => t('@message <a href=":url">Reconnect to Quant Cloud</a>.', [
        '@message' => AuthService::reconnectMessage($reason),
        ':url' => Url::fromRoute('ai_provider_quant_cloud.oauth_connect')->toString(),
      ]),
      'severity' => $severity,
    ],
  ];
}

/**
 * Raise chat defaults for longer agent and tool-use responses.
 */
function ai_provider_quant_cloud_update_10001(): void {
  // Keep install hooks independent of runtime class autoloading.
  // These mirror QuantCloudClient::DEFAULT_MAX_TOKENS and DEFAULT_TIMEOUT.
  $default_max_tokens = 16384;
  $default_timeout = 120;

  $config = \Drupal::configFactory()
    ->getEditable('ai_provider_quant_cloud.settings');

  $changed = FALSE;
  $max_tokens = $config->get('model.max_tokens');
  if (!$max_tokens || (int) $max_tokens === 1000) {
    $config->set('model.max_tokens', $default_max_tokens);
    $changed = TRUE;
  }

  $timeout = $config->get('advanced.timeout');
  if (!$timeout || (int) $timeout === 30) {
    $config->set('advanced.timeout', $default_timeout);
    $changed = TRUE;
  }

  if ($config->get('advanced.connect_timeout') === NULL) {
    $config->set('advanced.connect_timeout', 10);
    $changed = TRUE;
  }

  if ($config->get('advanced.streaming_timeout') === NULL) {
    $config->set('advanced.streaming_timeout', 60);
    $changed = TRUE;
  }

  if ($config->get('advanced.enable_logging') === NULL) {
    $config->set('advanced.enable_logging', FALSE);
    $changed = TRUE;
  }

  if ($changed) {
    $config->save(TRUE);
  }
}

/**
 * Raise default max tokens from 4096 to 16384 for tool-use payloads.
 */
function ai_provider_quant_cloud_update_10002(): void {
  $config = \Drupal::configFactory()
    ->getEditable('ai_provider_quant_cloud.settings');

  $max_tokens = (int) $config->get('model.max_tokens');
  if ($max_tokens <= 4096) {
    $config->set('model.max_tokens', 16384)->save(TRUE);
  }
}

/**
 * Raise default max tokens from 16384 to 32768 for richer tool-use chains.
 */
function ai_provider_quant_cloud_update_10003(): void {
  $config = \Drupal::configFactory()
    ->getEditable('ai_provider_quant_cloud.settings');

  $max_tokens = (int) $config->get('model.max_tokens');
  if ($max_tokens <= 16384) {
    $config->set('model.max_tokens', 32768)->save(TRUE);
  }
}
