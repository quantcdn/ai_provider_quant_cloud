<?php

declare(strict_types=1);

use Drupal\ai_provider_quant_cloud\Client\QuantCloudClient;

/**
 * @file
 * Install and update hooks for the Quant Cloud AI Provider module.
 */

/**
 * Raise chat defaults for longer agent and tool-use responses.
 */
function ai_provider_quant_cloud_update_10001(): void {
  $default_max_tokens = QuantCloudClient::DEFAULT_MAX_TOKENS;
  $default_timeout = QuantCloudClient::DEFAULT_TIMEOUT;

  $config = \Drupal::configFactory()
    ->getEditable('ai_provider_quant_cloud.settings');

  $changed = FALSE;
  $max_tokens = $config->get('model.max_tokens');
  if (!$max_tokens || (int) $max_tokens === 1000) {
    $config->set('model.max_tokens', $default_max_tokens);
    $changed = TRUE;
  }

  $timeout = $config->get('advanced.timeout');
  if (!$timeout || (int) $timeout === 30) {
    $config->set('advanced.timeout', $default_timeout);
    $changed = TRUE;
  }

  if ($changed) {
    $config->save(TRUE);
  }
}
